#!/usr/bin/env sh
# POSIX wrapper for devapps.py -- the App Launcher CLI.
# The engine is Python; this only picks an interpreter and forwards arguments.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" "$here/devapps.py" "$@"
  fi
done
echo "Python 3 was not found on PATH. Install it and try again." >&2
exit 1
